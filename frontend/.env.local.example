# ────────────────────────────────────────────────────────
# FLUX FRONTEND — Environment Variables
# Auto-updated by deploy script. Can also set manually.
# ────────────────────────────────────────────────────────

# Deployed FluxSettlement contract on Arc testnet
NEXT_PUBLIC_FLUX_ADDRESS=0xYOUR_FLUX_CONTRACT_ADDRESS

# USDC token on Arc testnet (verify at testnet.arcscan.app)
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Arc testnet
NEXT_PUBLIC_CHAIN_ID=5042002
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_EXPLORER_URL=https://testnet.arcscan.app
