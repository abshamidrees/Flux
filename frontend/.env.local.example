# ────────────────────────────────────────────────────────
# FLUX FRONTEND — Environment Variables
# Auto-updated by deploy script. Can also set manually.
# ────────────────────────────────────────────────────────

# Deployed FluxSettlement contract on Arc testnet
NEXT_PUBLIC_FLUX_ADDRESS=0xYOUR_FLUX_CONTRACT_ADDRESS

# USDC token on Arc testnet (verify at testnet.arcscan.app)
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Arc testnet
NEXT_PUBLIC_CHAIN_ID=5042002
NEXT_PUBLIC_EXPLORER_URL=https://testnet.arcscan.app

# Optional: overrides the public Arc Testnet RPC used for every on-chain read
# (balances, quotes, allowance). Falls back to https://rpc.testnet.arc.network
# if unset — drop in a better endpoint (e.g. a Circle-issued, API-keyed one)
# with no code change.
NEXT_PUBLIC_ARC_RPC_URL=

# Deployed FluxLimitOrder contract on Arc testnet (set by scripts/deployLimitOrder.ts)
NEXT_PUBLIC_FLUX_LIMIT_ORDER_ADDRESS=

# ────────────────────────────────────────────────────────
# CIRCLE — User-Controlled Wallets (Phase H Part 1), from the Circle
# Developer Console. NEXT_PUBLIC_CIRCLE_APP_ID is the "App ID" specifically
# (a UUID) — NOT the "Client Key" field (starts with TEST_CLIENT_KEY: /
# CLIENT_KEY:), which is a different value from a different console section
# and will silently fail the Web SDK if pasted here by mistake. If unsure,
# verify against `GET https://api.circle.com/v1/w3s/config/entity` with
# your CIRCLE_API_KEY — that endpoint returns the real appId.
# ────────────────────────────────────────────────────────

NEXT_PUBLIC_CIRCLE_APP_ID=

# Server-only Circle API key (TEST_API_KEY:... for sandbox). Set directly in
# the Vercel dashboard (encrypted env vars), not in a committed .env file —
# never prefix this NEXT_PUBLIC_, it must never reach the browser bundle.
CIRCLE_API_KEY=

# ────────────────────────────────────────────────────────
# KEEPER — server-only secrets. NEVER prefix these NEXT_PUBLIC_.
# Set directly in the Vercel dashboard (encrypted env vars), not in a
# committed .env file. Do not put real values in this example file.
# ────────────────────────────────────────────────────────

# Testnet-only signer, funded with just enough native gas token to pay for
# fills. This wallet can call executeOrder on anyone's behalf — keep its
# balance minimal and never reuse a key that holds real funds elsewhere.
KEEPER_PRIVATE_KEY=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` on every
# scheduled call to /api/keeper/limit-orders. Without a match the route
# returns 401 — this is what keeps it from being publicly callable.
CRON_SECRET=
