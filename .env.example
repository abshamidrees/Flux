# ────────────────────────────────────────────────
# FLUX — Environment Variables
# Copy this file to .env and fill in your values
# ────────────────────────────────────────────────

# Your deployer wallet private key (no 0x prefix needed by hardhat)
PRIVATE_KEY=your_private_key_here

# Arc Testnet USDC address — verify at testnet.arcscan.app before deploying
# Circle USDC on Arc testnet (check docs.arc.network for latest)
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Optional: Sepolia RPC for backup testing
SEPOLIA_RPC_URL=https://rpc.sepolia.org
